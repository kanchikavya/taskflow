# TaskFlow Environment Variables Configuration Sample

# Security
SECRET_KEY=django-insecure-taskflow-senior-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Set USE_MYSQL=True for MySQL)
USE_MYSQL=False
MYSQL_DATABASE=taskflow_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
